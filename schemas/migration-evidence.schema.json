{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration evidence",
  "description": "Structure only; check_evidence.py additionally checks cross-field consistency. Neither authenticates execution or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice", "status", "approval", "proposer", "verifier", "source_revision", "java_revision", "gates", "commands", "cases"],
  "properties": {
    "slice": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"$ref": "#/$defs/status"},
    "approval": {"type": "string", "minLength": 1},
    "proposer": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "java_revision": {"type": "string", "minLength": 1},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "java", "semantics", "parity"],
      "properties": {
        "harness": {"$ref": "#/$defs/status"},
        "java": {"$ref": "#/$defs/status"},
        "semantics": {"$ref": "#/$defs/status"},
        "parity": {"$ref": "#/$defs/status"}
      }
    },
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "status": {"enum": ["pass", "fail", "blocked"]},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "command", "exit_code", "artifact"],
      "properties": {
        "gate": {"enum": ["harness", "java", "parity"]},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"]},
        "artifact": {"type": "string", "minLength": 1}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "reference", "source_revision", "input_sha256", "output_sha256", "compiler_options", "runtime", "charset", "framing"],
      "properties": {
        "origin": {"const": "zos-observed"},
        "reference": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_options": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "charset": {"type": "string", "minLength": 1},
        "framing": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rules", "baseline"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/baseline"}]}
      }
    }
  }
}
